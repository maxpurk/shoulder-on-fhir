# Copy to ../.env.prod (repo root) and fill in real values. .env.prod is
# gitignored — it holds a password hash, keep it out of version control.

# Subdomains pointed at this server's IP (A/AAAA record) before first start —
# Caddy requests a Let's Encrypt cert on boot and needs them resolvable.
DOMAIN=demo.example.com
SDC_DOMAIN=sdc-demo.example.com

# Serves the built IG HTML site (ig/output/, produced by
# `./build-and-deploy.sh --genonce`) as static files, same shared Basic Auth.
IG_DOMAIN=ig.example.com

# Contact address for Let's Encrypt expiry notices (not shown to visitors).
ACME_EMAIL=you@example.com

# Shared credential handed out to friends alongside the link.
BASIC_AUTH_USER=friend

# Bcrypt hash of the password — never put the plaintext password here.
# Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'choose-a-password'
#
# IMPORTANT: double every `$` in the generated hash (Docker Compose's .env
# parser treats a single `$` as variable interpolation and silently mangles
# the hash otherwise — e.g. $2a$14$abc... becomes $$2a$$14$$abc...).
BASIC_AUTH_HASH=$$2a$$14$$REPLACE_WITH_OUTPUT_OF_hash-password
