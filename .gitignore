# FHIR Validator CLI (~250 MB, downloaded on first use)
tools/validator_cli.jar
tools/validation-output/

# tx.fhir.org response cache (populated by validator -txCache; first run slow,
# subsequent runs fast). Wipe to force re-fetch.
tools/.tx-cache/

# FHIR R4 core package cache (~69 MB, downloaded by load-base-profiles.sh)
seed/.fhir-r4-core-cache/

# EU base + xver-r5 caches (downloaded by load-eu-base-profiles.sh)
seed/.fhir-eu-base-cache/
seed/.fhir-xver-r5-cache/

# UV extensions + HL7 terminology caches (downloaded by load-uv-extensions.sh, ADR-0053)
seed/.fhir-uv-extensions-cache/
seed/.fhir-terminology-r4-cache/

# IPS package cache (downloaded by load-ips-package.sh, ADR-0056)
seed/.fhir-ips-cache/

# macOS
.DS_Store

# Production secrets (Basic Auth hash, domains) — see deploy/.env.prod.example
.env.prod

# Generated copies of shared/*.ts (ADR-0157) — regenerated by
# tools/sync-shared-code.sh (build-and-deploy.sh runs it automatically).
# The canonical source lives in shared/, which IS tracked.
frontend/src/lib/shared/
sdc-frontend/src/lib/shared/

# offline extraction-test bundles
*/dist-test/

# IG Publisher working directories. The built site, the scratch pages and the
# publisher jar are regenerated by build-and-deploy.sh; only the installable
# FHIR packages are tracked.
ig/output/*
!ig/output/*.tgz
ig/temp/
ig/input-cache/
