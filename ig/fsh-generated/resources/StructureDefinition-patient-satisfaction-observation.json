          {
            "code": "CodeableConcept"
          }
        ],
        "binding": {
          "strength": "required",
          "valueSet": "https://maxpurk.github.io/shoulder-on-fhir/ValueSet/satisfaction-scale"
        }
      }
    ]
  }
