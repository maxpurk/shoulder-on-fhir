{
  "resourceType": "StructureDefinition",
  "id": "rotator-cuff-follow-up-bundle",
  "url": "https://maxpurk.github.io/shoulder-on-fhir/StructureDefinition/rotator-cuff-follow-up-bundle",
  "version": "0.2.0",
  "name": "RotatorCuffFollowUpBundle",
  "title": "Rotator Cuff Follow-Up Bundle",
  "status": "draft",
  "date": "2026-06-07",
  "publisher": "Hasso Plattner Institute",
  "description": "Transaction bundle defining a single post-operative follow-up visit submission\nfor an already-registered patient in a rotator cuff surgery registry. Third of\nthree named submission profiles in the registry workflow:\nRotatorCuffRegistrationBundle (pre-op, T0) → RotatorCuffSurgeryBundle\n(surgical event, T1) → RotatorCuffFollowUpBundle (per-visit increment, Q11\ntimepoints).\n\nPer visit the bundle contains:\n- exactly one ShoulderEncounter (expert consensus Q10), the realised follow-up visit\n- one or more ShoulderObservation entries, Q9 post-op exam (ROM, MMT,\n  provocation tests) and Q12 PROMs (Constant, SSV/SANE, VAS pain, satisfaction,\n  return-to-activity)\n- optionally one RotatorCuffQuestionnaireResponse, the answered PROM form\n- optionally one ShoulderImagingStudy, only at the research re-imaging\n  timepoint (Q13 exception)\n\nThe bundle does NOT contain Patient, Condition, or Procedure: Patient and\nCondition were established by the prior RotatorCuffRegistrationBundle (T0),\nthe surgical Procedure(s) by the prior RotatorCuffSurgeryBundle (T1). All are\nreferenced via their already-persisted IDs (Encounter.subject -> Patient/{id};\nEncounter.reasonReference -> Condition/{id}; Observation.subject -> Patient/{id};\nObservation.encounter -> Encounter/{urn-uuid-of-this-bundle-entry}).",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "Bundle",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Bundle",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Bundle.type",
        "path": "Bundle.type",
        "fixedCode": "transaction"
      },
      {
        "id": "Bundle.entry",
        "path": "Bundle.entry",
        "slicing": {
          "discriminator": [
            {
              "type": "type",
              "path": "resource"
            },
            {
              "type": "profile",
              "path": "resource"
            }
          ],
          "rules": "open"
        },
        "short": "Entry resources in a single follow-up visit submission",
        "min": 2
      },
      {
        "id": "Bundle.entry.fullUrl",
        "path": "Bundle.entry.fullUrl",
        "min": 1
      },
      {
        "id": "Bundle.entry:encounter",
        "path": "Bundle.entry",
        "sliceName": "encounter",
        "min": 1,
        "max": "1"
      },
      {
        "id": "Bundle.entry:encounter.resource",
        "path": "Bundle.entry.resource",
        "min": 1,
        "type": [
          {
            "code": "Encounter",
            "profile": [
              "https://maxpurk.github.io/shoulder-on-fhir/StructureDefinition/shoulder-encounter"
            ]
          }
        ]
      },
      {
        "id": "Bundle.entry:encounter.resource.class",
        "path": "Bundle.entry.resource.class",
        "patternCoding": {
          "code": "AMB",
          "system": "http://terminology.hl7.org/CodeSystem/v3-ActCode",
          "display": "ambulatory"
        }
      },
      {
        "id": "Bundle.entry:observation",
        "path": "Bundle.entry",
        "sliceName": "observation",
        "min": 1,
        "max": "*"
      },
      {
        "id": "Bundle.entry:observation.resource",
        "path": "Bundle.entry.resource",
        "min": 1,
        "type": [
          {
            "code": "Observation",
            "profile": [
              "https://maxpurk.github.io/shoulder-on-fhir/StructureDefinition/shoulder-observation"
            ]
          }
        ]
      },
      {
        "id": "Bundle.entry:questionnaireResponse",
        "path": "Bundle.entry",
        "sliceName": "questionnaireResponse",
        "min": 0,
        "max": "1"
      },
      {
        "id": "Bundle.entry:questionnaireResponse.resource",
        "path": "Bundle.entry.resource",
        "min": 1,
        "type": [
          {
            "code": "QuestionnaireResponse",
            "profile": [
              "https://maxpurk.github.io/shoulder-on-fhir/StructureDefinition/rotator-cuff-questionnaire-response"
            ]
          }
        ]
      },
      {
        "id": "Bundle.entry:imagingStudy",
        "path": "Bundle.entry",
        "sliceName": "imagingStudy",
        "min": 0,
        "max": "*"
      },
      {
        "id": "Bundle.entry:imagingStudy.resource",
        "path": "Bundle.entry.resource",
        "min": 1,
        "type": [
          {
            "code": "ImagingStudy",
            "profile": [
              "https://maxpurk.github.io/shoulder-on-fhir/StructureDefinition/shoulder-imaging-study"
            ]
          }
        ]
      }
    ]
  }
}
