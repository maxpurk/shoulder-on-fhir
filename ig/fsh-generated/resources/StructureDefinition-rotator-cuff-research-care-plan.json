{
  "resourceType": "StructureDefinition",
  "id": "rotator-cuff-research-care-plan",
  "url": "https://maxpurk.github.io/shoulder-on-fhir/StructureDefinition/rotator-cuff-research-care-plan",
  "version": "0.4.0",
  "name": "RotatorCuffResearchCarePlan",
  "title": "Rotator Cuff Research Care Plan",
  "status": "draft",
  "date": "2026-08-04",
  "publisher": "Hasso Plattner Institute",
  "description": "Profile for documenting the planned follow-up schedule for a rotator cuff\nsurgery registry participant (expert consensus Q11, research follow-up at 5 named\ntimepoints Q11.a–e: 6 weeks, 3 months, 6 months, 1 year, 2 years). Encodes the\nminimum follow-up duration and research-defined assessment timepoints (e.g.\n6 weeks, 3 months, 6 months, 12 months, 2 years post-surgery) so that\ncompleteness of follow-up can be tracked and reported.",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "CarePlan",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/CarePlan",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "CarePlan.status",
        "path": "CarePlan.status",
        "mustSupport": true
      },
      {
        "id": "CarePlan.intent",
        "path": "CarePlan.intent",
        "patternCode": "plan",
        "mustSupport": true
      },
      {
        "id": "CarePlan.subject",
        "path": "CarePlan.subject",
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "https://maxpurk.github.io/shoulder-on-fhir/StructureDefinition/shoulder-patient"
            ]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "CarePlan.period",
        "path": "CarePlan.period",
        "mustSupport": true
      },
      {
        "id": "CarePlan.period.start",
        "path": "CarePlan.period.start",
        "mustSupport": true
      },
      {
        "id": "CarePlan.period.end",
        "path": "CarePlan.period.end",
